ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://nubagz:nubagz@db:5432/nubagz
JWT_ALGORITHM=RS256
JWT_KEY_ID=nubagz-1
JWT_AUDIENCE=nubagz-api
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# JWT_SECRET is retained only for explicit local/test HS256 deployments.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Privy social identity verification. NuBagz supports Google and X only.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Optional dedicated HMAC secret for per-user X proof codes.
SOCIAL_PROOF_SECRET=

# Robinhood Chain mainnet is NuBagz's primary EVM network.
EVM_RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
EVM_RPC_AVALANCHE=
EVM_RPC_ETHEREUM=
EVM_RPC_BASE=
EVM_RPC_ARBITRUM=
EVM_RPC_POLYGON=

# Genuine multi-aggregator NuBagz Swap.
ZEROX_API_KEY=
LIFI_API_KEY=
LIFI_INTEGRATOR=nubagz
NUBAGZ_SWAP_FEE_BPS=75
NUBAGZ_SWAP_FEE_RECIPIENT=

GAS_SPONSOR_PROVIDER_BASE_URL=
GAS_SPONSOR_PROVIDER_API_KEY=
