ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://nubagz:nubagz@db:5432/nubagz
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Privy social identity verification. PRIVY_VERIFICATION_KEY accepts the
# application's ES256 public JWK JSON or PEM public key.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# Optional dedicated HMAC secret for per-user X proof codes. If empty,
# NuBagz falls back to JWT_SECRET. Use a long random value in production.
SOCIAL_PROOF_SECRET=

EVM_RPC_AVALANCHE=
EVM_RPC_ETHEREUM=
EVM_RPC_BASE=
EVM_RPC_ARBITRUM=
EVM_RPC_POLYGON=

SWAP_PROVIDER_BASE_URL=
SWAP_PROVIDER_API_KEY=
GAS_SPONSOR_PROVIDER_BASE_URL=
GAS_SPONSOR_PROVIDER_API_KEY=
