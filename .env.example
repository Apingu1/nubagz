# Core NuBagz auth (HS256 is fine for local development without embedded wallets)
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
JWT_KEY_ID=nubagz-1

# For Privy custom JWT auth + embedded wallets, switch to RS256 and provide PEM keys.
# Store multiline PEM values with literal \n characters in .env.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# NuBagz Privy app public frontend identifiers.
# App IDs and public verification keys are public configuration; never place a
# Privy app secret, OAuth client secret, or other private credential in this file.
VITE_PRIVY_APP_ID=cmt5cxn9k00e40ckw69x25hj1
VITE_PRIVY_CLIENT_ID=

# Backend verification for Privy identity tokens used by X/Google social login.
# PRIVY_APP_ID matches VITE_PRIVY_APP_ID. The verification key below is the
# application's public ES256 PEM key, stored on one line with literal \n escapes.
PRIVY_APP_ID=cmt5cxn9k00e40ckw69x25hj1
PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEEi8jpKzz7rmE7/akKzYnx5cSzXTyIuHIrR6GndL6hpCIDYl3ndqxZ05h8Urm6dVTXblKtw+zmnjRedcvYqCLMg==\n-----END PUBLIC KEY-----'

# EVM JSON-RPC endpoints used for authoritative on-chain mission verification.
# Configure only the chains you intend to support.
EVM_RPC_AVALANCHE=
EVM_RPC_ETHEREUM=
EVM_RPC_BASE=
EVM_RPC_ARBITRUM=
EVM_RPC_POLYGON=

# Optional executable integrations. Leave blank to keep NuBagz in safe non-executing mode.
# See ECONOMY_SETUP.md for the provider contracts expected by the backend.
SWAP_PROVIDER_BASE_URL=
SWAP_PROVIDER_API_KEY=
GAS_SPONSOR_PROVIDER_BASE_URL=
GAS_SPONSOR_PROVIDER_API_KEY=
