# Core NuBagz auth (HS256 is fine only for local development/test)
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
JWT_KEY_ID=nubagz-1
JWT_AUDIENCE=nubagz-api

# Production Docker startup fails closed unless RS256 and both PEM keys are supplied.
# For Privy custom JWT auth + embedded wallets, use RS256 and provide PEM keys.
# Store multiline PEM values with literal \n characters in .env.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# NuBagz Privy app public frontend identifiers.
VITE_PRIVY_APP_ID=cmt5cxn9k00e40ckw69x25hj1
VITE_PRIVY_CLIENT_ID=

# Backend verification for Privy identity tokens used by X/Google social login.
PRIVY_APP_ID=cmt5cxn9k00e40ckw69x25hj1
PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEEi8jpKzz7rmE7/akKzYnx5cSzXTyIuHIrR6GndL6hpCIDYl3ndqxZ05h8Urm6dVTXblKtw+zmnjRedcvYqCLMg==\n-----END PUBLIC KEY-----'

# EVM JSON-RPC endpoints used for authoritative on-chain verification.
# Robinhood Chain (4663) is the primary network. The official public RPC is
# rate-limited; use a dedicated provider URL in production if available.
EVM_RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
EVM_RPC_AVALANCHE=
EVM_RPC_ETHEREUM=
EVM_RPC_BASE=
EVM_RPC_ARBITRUM=
EVM_RPC_POLYGON=

# NuBagz Swap — genuine aggregator-backed wallet execution.
# 0x and LI.FI both support Robinhood Chain. NuBagz charges the configured
# integrator fee on executable quotes; 75 bps = 0.75%.
ZEROX_API_KEY=
LIFI_API_KEY=
LIFI_INTEGRATOR=nubagz
NUBAGZ_SWAP_FEE_BPS=75
# EVM treasury address that receives 0x affiliate fees.
NUBAGZ_SWAP_FEE_RECIPIENT=

# Optional sponsored-gas provider for creator-funded on-chain Bag Work.
GAS_SPONSOR_PROVIDER_BASE_URL=
GAS_SPONSOR_PROVIDER_API_KEY=
