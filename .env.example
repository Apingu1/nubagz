# Core NuBagz auth (HS256 is fine for local development without embedded wallets)
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
JWT_KEY_ID=nubagz-1

# For Privy custom JWT auth + embedded wallets, switch to RS256 and provide PEM keys.
# Store multiline PEM values with literal \n characters in .env.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Public frontend identifiers from your Privy app dashboard.
# Leave blank to run NuBagz with payout-only addresses and without wallet connection/creation.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# EVM JSON-RPC endpoints used for authoritative on-chain mission verification.
# Configure only the chains you intend to support.
EVM_RPC_AVALANCHE=
EVM_RPC_ETHEREUM=
EVM_RPC_BASE=
EVM_RPC_ARBITRUM=
EVM_RPC_POLYGON=
